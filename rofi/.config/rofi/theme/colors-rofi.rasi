/* Rofi Catppuccin Mocha Theme */
* {
    background:     #1e1e2e;  /* Catppuccin Mocha base */
    foreground:     #cdd6f4;  /* Catppuccin Mocha text */
    cursor:         #89b4fa;  /* Catppuccin Mocha blue */
    
    /* Catppuccin Mocha color palette */
    color0:         #1e1e2e;  /* base */
    color1:         #f38ba8;  /* red */
    color2:         #a6e3a1;  /* green */
    color3:         #f9e2af;  /* yellow */
    color4:         #89b4fa;  /* blue */
    color5:         #f5c2e7;  /* magenta */
    color6:         #94e2d5;  /* cyan */
    color7:         #cdd6f4;  /* text */
    color8:         #313244;  /* surface0 */
    color9:         #f38ba8;  /* red bright */
    color10:        #a6e3a1;  /* green bright */
    color11:        #f9e2af;  /* yellow bright */
    color12:        #89b4fa;  /* blue bright */
    color13:        #f5c2e7;  /* magenta bright */
    color14:        #94e2d5;  /* cyan bright */
    color15:        #e5e9f0;  /* surface1 */
    
    /* Semantic color aliases */
    bg:             @background;
    fg:             @foreground;
    bg-alt:         @color8;
    bg-dim:         @color0;
    fg-dim:         #a6adc8;
    fg-bright:      @color15;
    
    accent:         @color4;
    accent-alt:     @color12;
    
    red:            @color1;
    green:          @color2;
    yellow:         @color3;
    blue:           @color4;
    magenta:        @color5;
    cyan:           @color6;
    
    red-bright:     @color9;
    green-bright:   @color10;
    yellow-bright:  @color11;
    blue-bright:    @color12;
    magenta-bright: @color13;
    cyan-bright:    @color14;
}
