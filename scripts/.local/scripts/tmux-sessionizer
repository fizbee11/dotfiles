#!/usr/bin/env bash

project_dirs=(
    ~/dev/work
    ~/dev/data
    ~/dev/fb
    ~/dev/home
    ~/dev/prof
    ~/Syncthing
)

# find errors on paths that don't exist, so keep only the ones present
existing_dirs=()
for dir in "${project_dirs[@]}"; do
    [[ -d $dir ]] && existing_dirs+=("$dir")
done

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find "${existing_dirs[@]}" \
        -mindepth 1 -maxdepth 1 -type d | fzf --prompt="Select project: " --height=~80% --layout=reverse --border --exit-0)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

if [[ -z $TMUX ]]; then
    tmux attach -t $selected_name
else
    tmux switch-client -t $selected_name
fi
