# -*- conf -*-

font=JetBrainsMono NF:size=14

[environment]

[bell]

[scrollback]
lines=1000

[url]

[cursor]
style=block
blink=no
beam-thickness=1.5

[mouse]
hide-when-typing=no
alternate-scroll-mode=yes

[touch]

[colors]
alpha=1.0
background=#2e3440
foreground=#eceff4
flash=#ebcb8b
flash-alpha=0.5

## Normal/regular colors (color palette 0-7)
regular0=#2e3440
regular1=#bf616a
regular2=#a3be8c
regular3=#ebcb8b
regular4=#5e81ac
regular5=#b48ead
regular6=#88c0d0
regular7=#d8dee9

## Bright colors (color palette 8-15)
bright0=#4c566a
bright1=#bf616a
bright2=#a3be8c
bright3=#ebcb8b
bright4=#81a1c1
bright5=#b48ead
bright6=#8fbcbb
bright7=#eceff4

## Misc colors
selection-foreground=#2e3440
selection-background=#eceff4
jump-labels=#2e3440 #ebcb8b
scrollback-indicator=#2e3440 #81a1c1
search-box-no-match=#2e3440 #bf616a
search-box-match=#2e3440 #ebcb8b
urls=#88c0d0

[key-bindings]

[mouse-bindings]
